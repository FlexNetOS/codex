{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "root_cause",
    "evidence",
    "actions",
    "tests",
    "risks"
  ],
  "properties": {
    "summary": { "type": "string" },
    "root_cause": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail"],
        "properties": {
          "kind": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "description"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["done", "recommended", "blocked"]
          },
          "description": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run", "blocked"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "items": { "type": "string" } }
  }
}
